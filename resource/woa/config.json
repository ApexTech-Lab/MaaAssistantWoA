            "A321": 7, "A21N": 7, "A21NX": 7, "A21NY": 7,
            "A320": 7, "A20N": 7, "A319": 7, "A19N": 7, "A318": 7,
            "A306": 8,
            "B763F": 11, "B738": 7, "B38M": 7, "B734": 7,
            "E190": 6, "E195": 6, "E170": 4, "E175": 4, "E295": 6, "E290": 6,
            "A3ST": 20, "C17": 15,
            "B738F": 7, "A321F": 7, "B734F": 7,
            "BCS3": 7, "BCS1": 7,
            "CRJX": 4, "CRJ9": 4, "CRJ7": 4, "CRJ2": 4,
