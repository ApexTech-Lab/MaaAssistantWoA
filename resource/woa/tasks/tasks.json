{
    "_comment": "World of Airports 自动化任务配置 - 基于原 Python 代码逻辑",
    "_author": "Converted from Python game.py and app.py",
    "_version": "1.0",

    "WOA_Start": {
        "Doc": "WOA 启动任务入口",
        "algorithm": "JustReturn",
        "action": "DoNothing",
        "next": ["WOA_FindAircraft"]
    },

    "WOA_FindAircraft": {
        "Doc": "查找需要操作的飞机图标",
        "algorithm": "MatchTemplate",
        "action": "Click",
        "template": "require_action.png",
        "roi": [0, 0, 2560, 1440],
        "threshold": 0.8,
        "next": ["WOA_HandleAircraft"],
        "on_error_next": ["WOA_CheckStartPage"],
        "maxTimes": 999,
        "postDelay": 500
    },

    "WOA_HandleAircraft": {
        "Doc": "处理飞机 - 检查各种可能的按钮状态",
        "algorithm": "JustReturn",
        "action": "DoNothing",
        "next": [
            "WOA_ClearToLand",
            "WOA_Confirm",
            "WOA_AssignStand",
            "WOA_AssignCrew",
            "WOA_Taxi",
            "WOA_Pushback",
            "WOA_CrossRunway",
            "WOA_Lineup",
            "WOA_Takeoff",
            "WOA_ClaimReward"
        ]
    },

    "WOA_ClearToLand": {
        "Doc": "准许降落",
        "algorithm": "MatchTemplate",
        "action": "Click",
        "template": ["clear_land.png", "land.png"],
        "roi": [0, 0, 2560, 1440],
        "threshold": 0.8,
        "next": ["WOA_FindAircraft"],
        "on_error_next": ["#next"],
        "postDelay": 500
    },

    "WOA_Confirm": {
