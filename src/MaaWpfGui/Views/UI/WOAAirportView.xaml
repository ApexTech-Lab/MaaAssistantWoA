<UserControl
    x:Class="MaaWpfGui.Views.UI.WOAAirportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:ui="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:DataContext="{d:DesignInstance {x:Type ui:WOAAirportViewModel}}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title  -->
        <controls:TextBlock
            Grid.Row="0"
            Margin="10,20,10,30"
            HorizontalAlignment="Center"
            FontSize="24"
            FontWeight="Bold"
            Text="World of Airports 自动化管理" />

        <!--  Configuration Section  -->
        <Border
            Grid.Row="1"
            Margin="10"
            Padding="20"
            Background="{DynamicResource RegionBrushOpacity50}"
            CornerRadius="8">
            <StackPanel>
                <controls:TextBlock
                    Margin="0,0,0,15"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="配置选项" />

                <!--  Airport Selection  -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:TextBlock
                        Grid.Column="0"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="选择机场:" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="200"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Display"
                        IsEnabled="{Binding Idle}"
                        ItemsSource="{Binding AirportList}"
                        SelectedValue="{Binding SelectedAirport}"
                        SelectedValuePath="Value" />
                </Grid>

                <!--  Options  -->
                <StackPanel Margin="0,10,0,0" Orientation="Vertical">
                    <CheckBox
                        Margin="0,5"
                        Content="启用地勤分配（自动滑动地勤数量到最大值）"
                        FontSize="14"
                        IsChecked="{Binding EnableCrewAssignment}"
                        IsEnabled="{Binding Idle}" />
                    <CheckBox
                        Margin="0,5"
                        Content="启用特殊操作（穿越跑道、除冰等）"
                        FontSize="14"
                        IsChecked="{Binding EnableSpecialOperations}"
                        IsEnabled="{Binding Idle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Status Display  -->
        <Border
            Grid.Row="2"
            Margin="10"
            Padding="20"
            Background="{DynamicResource RegionBrushOpacity50}"
            CornerRadius="8">
            <StackPanel>
                <controls:TextBlock
                    Margin="0,0,0,15"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="运行状态" />

                <hc:ScrollViewer
                    Height="200"
                    IsInertiaEnabled="True"
                    PanningMode="Both"
                    VerticalScrollBarVisibility="Auto">
                    <controls:TextBlock
                        Margin="10"
                        FontSize="14"
                        Text="{Binding StatusInfo}"
                        TextWrapping="Wrap" />
                </hc:ScrollViewer>

                <!--  Progress Indicator  -->
                <Grid
                    Margin="0,15,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{c:Binding '!Idle'}">
                    <hc:LoadingCircle
                        Width="40"
                        Height="40"
                        DotCount="10"
                        DotInterval="60"
                        DotSpeed="8"
                        IsRunning="{c:Binding '!Idle'}"
                        Style="{StaticResource LoadingCircleBaseStyle}" />
                </Grid>
            </StackPanel>
        </Border>

        <!--  Control Buttons  -->
        <StackPanel
            Grid.Row="3"
            Margin="10"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="200"
                Height="80"
                Margin="20,10"
                Command="{s:Action LinkStart}"
                Content="{c:Binding 'Idle ? &quot;开始自动化&quot; : &quot;停止&quot;'}"
                FontSize="18"
                IsEnabled="{c:Binding 'Inited and !Stopping'}">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonPrimary}" TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Idle}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
